# Copy to .env and fill in. Never commit the real .env.
SITE_URL=https://www.datasattva.com
DS_CONTACT_EMAIL=hello@datasattva.com
DS_CONTACT_PHONE=
DS_OFFICE=Bengaluru, India
DS_LINKEDIN=

PORT=8080
NODE_ENV=production
DS_DATA_DIR=./data
DS_WEBHOOK_URL=
DS_WEBHOOK_TOKEN=

# --- Email delivery for the contact form / assessment results (set ONE provider) ---
# Zoho ZeptoMail (recommended for Zoho Mail users; works on Vercel)
ZEPTOMAIL_SEND_TOKEN=
ZEPTOMAIL_API_HOST=api.zeptomail.in
ZEPTOMAIL_BOUNCE_ADDRESS=
# or Resend:
RESEND_API_KEY=
# or SMTP (self-hosted only — Vercel may drop SMTP sends):
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Required whenever email is used:
ENQUIRY_TO_EMAIL=hello@datasattva.com
ENQUIRY_FROM_EMAIL=DataSattva Website <website@datasattva.com>
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_TOKEN=
